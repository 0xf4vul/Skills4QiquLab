{
  "name": "imagegen-textless-composite",
  "display_name": "无字底图 + 精确叠字出图法",
  "display_name_en": "Textless Backdrop + Precise Type Overlay",
  "version": "1.1.0",
  "license": "MIT",
  "agent_created": true,
  "derived_from": "2026-09-22 公众号→小绿书双端物料包实战（wechat-xiaolushu-material-pack 跑通后提纯）",
  "tags": [
    "image",
    "imagegen",
    "pillow",
    "typography",
    "封面",
    "卡片",
    "大字报",
    "公众号封面",
    "小绿书",
    "小红书",
    "物料包"
  ],
  "entry": {
    "skill": "SKILL.md",
    "scripts": [
      "scripts/render_card.py",
      "scripts/find_font.py",
      "scripts/strip_watermark.py",
      "scripts/selftest.py"
    ],
    "references": [
      "references/pillow-recipes.md"
    ],
    "examples": [
      "examples/01-step5-material-pack.md",
      "examples/demo-card.json",
      "examples/demo-card.png"
    ]
  },
  "runtime": {
    "python": ">=3.8",
    "deps": [
      "pillow"
    ],
    "font": "自动探测（可用 SKILL_FONT 覆盖）",
    "verify": "python scripts/selftest.py"
  },
  "hard_constraints": [
    "图像模型 prompt 必须带：Absolutely no text, no letters, no words, no numbers, no watermark, no logo",
    "所有中文与数字由 Pillow 叠加，禁止让模型渲染中文大字",
    "半透明元素必须画在 RGBA 图层上再 alpha_composite",
    "压暗条只能用纯色 + alpha mask，禁止深色→白色双色渐变",
    "输出图必须无水印（裁切或覆盖二选一）"
  ],
  "publish_ratios": {
    "公众号封面": "16:9（1600x900）",
    "公众号插图": "1:1（1080x1080）",
    "小绿书/小红书": "3:4（1080x1440）",
    "底图生成尺寸": "1536x1024 / 1024x1024 / 1024x1536"
  },
  "default_palette": {
    "deep": "#0E1A2E",
    "accent": "#E8A33D",
    "positive": "#5CD6A6",
    "ink": "#F4F6FA",
    "muted": "#96A8C6"
  },
  "commercial": {
    "license": "MIT",
    "commercial_use": true,
    "redistribution": true,
    "attribution_required": true
  }
}
